// Cloudflare Workers Static Assets — Worker 스크립트 없이 `dist/` 만 올린다.
// 계정 ID 는 두지 않는다. Workers Builds 가 연결된 계정으로 올리고, 로컬에서 올릴 때는
// `wrangler login` 한 계정을 쓴다.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdwire-site",
  "compatibility_date": "2026-09-30",
  // 배포 전에 빌드한다 — `wrangler deploy` · `wrangler dev` 가 이걸 먼저 돌린다. Workers Builds 는 대시보드의
  // 빌드 명령을 쓰고, 문서상 이 설정은 따르지 않는다(둘 다 같은 명령이라 겹쳐도 결과는 같다).
  // 감시는 소스만 — 기본(현재 디렉터리)이면 `dist/` 에 쓴 것이 다시 빌드를 부른다.
  "build": { "command": "pnpm run build", "watch_dir": ["src", "public"] },
  // 주소는 `minjun.kim/mdwire/`. `minjun.kim` 은 개인 사이트 워커의 Custom Domain 이고, 그 앞에서 이 두 라우트가 먼저
  // 받는다 — 둘인 이유는 `minjun.kim/mdwire*` 하나로 쓰면 `/mdwire-x` 같은 경로까지 잡기 때문. 옛 주소 `mdwire.minjun.dev`
  // 는 붙여 둔다 — 존(minjun.dev)의 Redirect Rule 이 그 호스트를 새 경로로 301 보내는데, 호스트가 살아 있어야 규칙이 돈다.
  "routes": [
    { "pattern": "minjun.kim/mdwire", "zone_name": "minjun.kim" },
    { "pattern": "minjun.kim/mdwire/*", "zone_name": "minjun.kim" },
    { "pattern": "mdwire.minjun.dev", "custom_domain": true }
  ],
  // 자산 디렉터리는 `dist/`, 페이지는 그 아래 `dist/mdwire/`(Astro `base` · `outDir`) — 요청 경로 그대로 파일을 찾기 때문이다.
  // `_headers` 는 루트에서만 읽혀 빌드 끝에 `dist/` 로 올린다(`astro.config.mjs`).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Worker Previews(PR 브랜치 프리뷰)의 설정. 정적 자산뿐이라 프로덕션과 다를 것이 없어 비워 둔다.
  "previews": {}
}
