---
// MDX 페이지가 frontmatter 의 `layout` 으로 쓰는 틀. 언어는 경로(`/ko/…`)에서 온다.
import { getRelativeLocaleUrl } from "astro:i18n";
import { localeOf, ui } from "../i18n";
import { hasMarkdown, markdownPath } from "../markdownCopies";
import { stripBase, withBase } from "../urls";
import SectionNav from "../components/SectionNav.astro";
import Pager from "../components/Pager.astro";
// 한국어 본문 글꼴. 유니코드 범위로 나뉜 woff2 라 페이지에 쓰인 글자의 조각만 받는다 — 영어 페이지는 받지 않는다.
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "../styles/global.css";

interface Props {
  frontmatter: { title: string; description?: string };
  // MDX 가 레이아웃에 넘기는 헤딩 목록 — 문서 사이드바의 절 목록이 된다.
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description } = Astro.props.frontmatter;
const lang = localeOf(Astro.currentLocale);
const t = ui[lang];
const other = lang === "en" ? "ko" : "en";

// 같은 문서의 다른 언어 주소 — base 와 `/ko` 를 떼면 언어와 무관한 경로가 남는다.
const path = stripBase(Astro.url.pathname);
const rest = path.replace(/^\/ko(?=\/|$)/, "").replace(/^\/|\/$/g, "");
const href = (page: string) => getRelativeLocaleUrl(lang, page);
// 언어 전환 — 같은 문서의 각 언어 주소. 404 는 언어별 페이지가 없다 — 각 언어의 개요로 보낸다.
const langHref = (l: "en" | "ko") => getRelativeLocaleUrl(l, rest === "404" ? "" : rest);
const nav = [
  { page: "", label: t.nav.home },
  { page: "why", label: t.nav.why },
  { page: "demo", label: t.nav.demo },
  { page: "docs", label: t.nav.docs },
];
// `docs/npm` 처럼 아래 페이지에 있어도 그 메뉴를 현재로 본다.
const isCurrent = (page: string) => rest === page || (page !== "" && rest.startsWith(`${page}/`));
// 배경 · 문서 · 데모 묶음은 왼쪽에 그 묶음의 목차를 둔다.
const section = isCurrent("docs") ? "docs" : isCurrent("demo") ? "demo" : isCurrent("why") ? "why" : undefined;
const pageTitle = rest === "" ? `mdwire — ${title}` : `${title} · mdwire`;
const summary = description ?? t.tagline;

// 검색 엔진과 링크 미리보기에 내보낼 것. 404 는 색인하지 않고 짝도 대지 않는다.
const notFound = rest === "404";
const site = Astro.site!;
const url = new URL(withBase(path), site).href;
const home = new URL(withBase("/"), site).href;
const urlOf = (l: "en" | "ko") => new URL(getRelativeLocaleUrl(l, rest), site).href;
const ogLocale = { en: "en_US", ko: "ko_KR" } as const;
// 개요와 문서는 원문 마크다운 사본이 있다(`/docs/npm.md`) — 에이전트는 HTML 대신 그걸 읽는다.
const markdown =
  !notFound && hasMarkdown(rest) ? new URL(withBase(markdownPath(path.replace(/^\/|\/$/g, ""))), site).href : undefined;

// 구조화 데이터(schema.org). 개요는 소프트웨어 자체를, 나머지는 그 소프트웨어를 다루는 글로 밝힌다.
const software = {
  "@type": "SoftwareSourceCode",
  "@id": `${home}#software`,
  name: "mdwire",
  description: ui.en.tagline,
  url: home,
  codeRepository: "https://github.com/minjun0219/mdwire",
  license: "https://opensource.org/licenses/MIT",
  programmingLanguage: ["Rust", "Go", "JavaScript", "WebAssembly"],
  keywords: "markdown, llm, telegram, slack, github, notion, streaming, wasm",
};
const ld = notFound
  ? undefined
  : rest === ""
    ? { "@context": "https://schema.org", ...software }
    : {
        "@context": "https://schema.org",
        "@type": rest.startsWith("docs") ? "TechArticle" : "WebPage",
        headline: title,
        description: summary,
        inLanguage: lang,
        url,
        about: software,
      };
// `</script>` 가 본문을 끊지 않게 `<` 를 이스케이프한다.
const ldJson = ld && JSON.stringify(ld).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={summary} />
    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    {
      notFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={url} />
          <link rel="alternate" hreflang="en" href={urlOf("en")} />
          <link rel="alternate" hreflang="ko" href={urlOf("ko")} />
          <link rel="alternate" hreflang="x-default" href={urlOf("en")} />
        </>
      )
    }
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="sitemap" type="application/xml" href={withBase("/sitemap.xml")} />
    <meta property="og:type" content={rest === "" ? "website" : "article"} />
    <meta property="og:site_name" content="mdwire" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta property="og:image" content={new URL(withBase("/og.png"), site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`mdwire — ${ui.en.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={href("")}>mdwire</a>
      <nav>
        {
          nav.map(({ page, label }) => (
            <a href={href(page)} aria-current={isCurrent(page) ? "page" : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      <div class="header-end">
        <nav class="lang-switch" aria-label={t.langSwitch}>
          {
            (["en", "ko"] as const).map((l) => (
              <a href={langHref(l)} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>
                {l.toUpperCase()}
              </a>
            ))
          }
        </nav>
        <a class="header-github" href="https://github.com/minjun0219/mdwire" aria-label="GitHub" title="GitHub">
          {/* GitHub 마크(Octicons mark-github, MIT). 색은 글자색을 따른다. */}
          <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>
      </div>
    </header>
    <div class:list={["page", { "with-sidebar": section }]}>
      {section && <SectionNav section={section} headings={Astro.props.headings} />}
      <main class="doc" data-copy-label={t.code.copy} data-copied-label={t.code.copied} data-anchor-label={t.code.anchor}>
        <slot />
        {section && <Pager section={section} />}
      </main>
    </div>
    <footer class="site-footer">
      <p class="footer-links">
        <a href="https://github.com/minjun0219/mdwire">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/minjun0219/mdwire/blob/main/LICENSE">{t.license}</a>
        <span aria-hidden="true">·</span>
        <a href={withBase("/llms.txt")} type="text/plain">llms.txt</a>
      </p>
      <p class="footer-by">by <a href="https://minjun.kim/?utm_source=mdwire&utm_medium=referral&utm_content=footer">minjun.kim</a></p>
    </footer>
    <script>
      import { initAnalytics } from "../analytics";
      import { registerWebMcp } from "../webmcp";

      initAnalytics();
      registerWebMcp();

      // 글을 고치지 않는 편의 기능 — 스크립트가 없어도 본문은 그대로 읽힌다. 문구는 `main` 의 data-* 에서 읽는다.
      const main = document.querySelector<HTMLElement>("main.doc");
      if (main) {
        const { copyLabel = "Copy", copiedLabel = "Copied", anchorLabel = "" } = main.dataset;

        const copy = async (button: HTMLButtonElement, text: string) => {
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            return;
          }
          button.textContent = copiedLabel;
          button.dataset.done = "";
          setTimeout(() => {
            button.textContent = copyLabel;
            delete button.dataset.done;
          }, 1500);
        };

        // 코드 블록마다 복사 버튼. 블록이 옆으로 스크롤해도 버튼이 따라가지 않게 바깥을 한 겹 감싼다.
        for (const pre of main.querySelectorAll<HTMLPreElement>("pre.astro-code")) {
          const box = document.createElement("div");
          box.className = "code-box";
          pre.replaceWith(box);
          box.append(pre);
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy";
          button.textContent = copyLabel;
          button.addEventListener("click", () => copy(button, pre.querySelector("code")?.textContent ?? pre.textContent ?? ""));
          box.append(button);
        }

        // 글을 미리 넣어 둔 버튼(홈의 설치 한 줄).
        for (const button of main.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
          button.addEventListener("click", () => copy(button, button.dataset.copy ?? ""));
        }

        // 절 제목 옆의 # 링크 — 주소를 복사해 절을 가리킬 수 있게.
        for (const h of main.querySelectorAll<HTMLHeadingElement>(":scope > :is(h2, h3)[id]")) {
          const a = document.createElement("a");
          a.className = "anchor";
          a.href = `#${h.id}`;
          a.textContent = "#";
          a.setAttribute("aria-label", anchorLabel);
          h.append(a);
        }
      }
    </script>
  </body>
</html>
