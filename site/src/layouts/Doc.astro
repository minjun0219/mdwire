---
// MDX 페이지가 frontmatter 의 `layout` 으로 쓰는 틀. 언어는 경로(`/ko/…`)에서 온다.
import { getRelativeLocaleUrl } from "astro:i18n";
import { localeOf, ui } from "../i18n";
import { hasMarkdown, markdownPath } from "../markdownCopies";
import SectionNav from "../components/SectionNav.astro";
// 한국어 본문 글꼴. 유니코드 범위로 나뉜 woff2 라 페이지에 쓰인 글자의 조각만 받는다 — 영어 페이지는 받지 않는다.
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
// 코드 글꼴. 한글이 정확히 영문 두 칸인 고정폭이라 코드 블록 속 한글 표와 정렬이 맞는다. 유니코드 범위로
// 나뉘어 있어 영문만 있는 코드는 라틴 조각(14KB)만 받는다.
import "@fontsource/nanum-gothic-coding/400.css";
import "../styles/global.css";

interface Props {
  frontmatter: { title: string; description?: string };
  // MDX 가 레이아웃에 넘기는 헤딩 목록 — 문서 사이드바의 절 목록이 된다.
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description } = Astro.props.frontmatter;
const lang = localeOf(Astro.currentLocale);
const t = ui[lang];
const other = lang === "en" ? "ko" : "en";

// 같은 문서의 다른 언어 주소 — `/ko` 를 떼면 언어와 무관한 경로가 남는다.
const rest = Astro.url.pathname.replace(/^\/ko(?=\/|$)/, "").replace(/^\/|\/$/g, "");
const href = (page: string) => getRelativeLocaleUrl(lang, page);
// 404 는 언어별 페이지가 없다 — 다른 언어의 개요로 보낸다.
const switchHref = getRelativeLocaleUrl(other, rest === "404" ? "" : rest);
const nav = [
  { page: "", label: t.nav.home },
  { page: "why", label: t.nav.why },
  { page: "demo", label: t.nav.demo },
  { page: "docs", label: t.nav.docs },
];
// `docs/npm` 처럼 아래 페이지에 있어도 그 메뉴를 현재로 본다.
const isCurrent = (page: string) => rest === page || (page !== "" && rest.startsWith(`${page}/`));
// 배경 · 문서 · 데모 묶음은 왼쪽에 그 묶음의 목차를 둔다.
const section = isCurrent("docs") ? "docs" : isCurrent("demo") ? "demo" : isCurrent("why") ? "why" : undefined;
const pageTitle = rest === "" ? `mdwire — ${title}` : `${title} · mdwire`;
const summary = description ?? t.tagline;

// 검색 엔진과 링크 미리보기에 내보낼 것. 404 는 색인하지 않고 짝도 대지 않는다.
const notFound = rest === "404";
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;
const urlOf = (l: "en" | "ko") => new URL(getRelativeLocaleUrl(l, rest), site).href;
const ogLocale = { en: "en_US", ko: "ko_KR" } as const;
// 개요와 문서는 원문 마크다운 사본이 있다(`/docs/npm.md`) — 에이전트는 HTML 대신 그걸 읽는다.
const markdown =
  !notFound && hasMarkdown(rest)
    ? new URL(markdownPath(Astro.url.pathname.replace(/^\/|\/$/g, "")), site).href
    : undefined;

// 구조화 데이터(schema.org). 개요는 소프트웨어 자체를, 나머지는 그 소프트웨어를 다루는 글로 밝힌다.
const software = {
  "@type": "SoftwareSourceCode",
  "@id": `${site.href}#software`,
  name: "mdwire",
  description: ui.en.tagline,
  url: site.href,
  codeRepository: "https://github.com/minjun0219/mdwire",
  license: "https://opensource.org/licenses/MIT",
  programmingLanguage: ["Rust", "Go", "JavaScript", "WebAssembly"],
  keywords: "markdown, llm, telegram, slack, github, notion, streaming, wasm",
};
const ld = notFound
  ? undefined
  : rest === ""
    ? { "@context": "https://schema.org", ...software }
    : {
        "@context": "https://schema.org",
        "@type": rest.startsWith("docs") ? "TechArticle" : "WebPage",
        headline: title,
        description: summary,
        inLanguage: lang,
        url,
        about: software,
      };
// `</script>` 가 본문을 끊지 않게 `<` 를 이스케이프한다.
const ldJson = ld && JSON.stringify(ld).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={summary} />
    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      notFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={url} />
          <link rel="alternate" hreflang="en" href={urlOf("en")} />
          <link rel="alternate" hreflang="ko" href={urlOf("ko")} />
          <link rel="alternate" hreflang="x-default" href={urlOf("en")} />
        </>
      )
    }
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={rest === "" ? "website" : "article"} />
    <meta property="og:site_name" content="mdwire" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta property="og:image" content={new URL("/og.png", site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`mdwire — ${ui.en.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={href("")}>mdwire</a>
      <nav>
        {
          nav.map(({ page, label }) => (
            <a href={href(page)} aria-current={isCurrent(page) ? "page" : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      <div class="header-end">
        <a href={switchHref} hreflang={other} lang={other}>{t.switchTo}</a>
        <a href="https://github.com/minjun0219/mdwire">GitHub</a>
      </div>
    </header>
    <div class:list={["page", { "with-sidebar": section }]}>
      {section && <SectionNav section={section} headings={Astro.props.headings} />}
      <main class="doc">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <p class="footer-links">
        <a href="https://github.com/minjun0219/mdwire">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/minjun0219/mdwire/blob/main/LICENSE">{t.license}</a>
      </p>
      <p class="footer-by">by <a href="https://minjun.kim">minjun.kim</a></p>
    </footer>
  </body>
</html>
